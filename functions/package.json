    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
